{
  "$schema": "./.claude/skills/umbrella-nuget-safe-upgrade/nuget-upgrade-exclusions.schema.json",
  "packages": [
    { "id": "AutoMapper", "reason": "Major version upgrade requires migration effort. Starting from version 15, it requires a licence." }
  ],
  "patterns": [],
  "frameworkCoupledFamilies": [
    "Microsoft.Extensions.",
    "Microsoft.AspNetCore.",
    "Microsoft.EntityFrameworkCore",
    "Microsoft.Maui.",
    "System.Text.Json",
    "System.Net.Http.Json",
    "System.Security.Cryptography.Xml"
  ],
  "frameworkMajorOverrides": {
    "netstandard2.0": 10,
    "net462": 10
  },
  "options": {
    "allowPrerelease": false
  }
}
